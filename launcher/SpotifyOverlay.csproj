<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Lanzador de bandeja (SpotifyOverlay.exe).
    Hace en Streamlabs el papel que el plugin obs-spotify-overlay.dll hacía en OBS:
    arranca SpotifyOverlayServer.exe en segundo plano y lo apaga al terminar.
    Compila contra .NET Framework 4.8 (incluido en Windows 10/11), así que pesa
    unos pocos KB y no necesita instalar ningún runtime.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SpotifyOverlay</AssemblyName>
    <RootNamespace>SpotifyOverlayLauncher</RootNamespace>
    <ApplicationIcon>..\assets\logo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>Spotify Local para Streamlabs</Product>
    <Copyright>MIT - alvarro71 (original) / ElGonzaaTK (port a Streamlabs)</Copyright>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Compile Include="..\shared\*.cs" Link="shared\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
